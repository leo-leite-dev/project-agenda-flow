# Env example for Agenda Flow
# Copy to .env.local and fill with your values.
# Never commit files containing real credentials.

# Public env vars (exposed to frontend) must be prefixed with VITE_
VITE_APP_NAME=Agenda Flow
VITE_APP_URL=http://localhost:5173

# Supabase public credentials (publishable key only — safe for the browser)
# Get these values from your Supabase project:
# Project Settings > API > Project URL and anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
